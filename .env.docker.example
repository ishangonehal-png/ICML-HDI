# ------------------------------
# Dockerized full-stack dev defaults
# ------------------------------
WEB_PORT=13000
API_PORT=18000
POSTGRES_PORT=15434
REDIS_PORT=16379

POSTGRES_USER=yc_aixbio
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=yc_aixbio

APP_ENV=development
APP_NAME=YC AIxBio Research API
API_V1_PREFIX=/v1
AUTO_CREATE_TABLES=true
ANALYSIS_QUEUE_KEY=aixbio:analysis:jobs
ANALYSIS_QUEUE_PROCESSING_KEY=aixbio:analysis:jobs:processing
ANALYSIS_QUEUE_DEDUPE_TTL_SECONDS=86400
ANALYSIS_WORKER_POLL_TIMEOUT_SECONDS=5
ANALYSIS_WORKER_REQUEUE_INFLIGHT_ON_START=true

# Required for /v1/agent/query LLM responses (compose will fail-fast if missing)
OPENAI_API_KEY=replace_with_real_key
OPENAI_MODEL=gpt-5.4

# Browser -> API (runs on your host machine)
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000

# Optional: disable frontend mock fallback (recommended for deployment validation)
NEXT_PUBLIC_DISABLE_MOCK_FALLBACK=true

# Web container -> API container
INTERNAL_API_BASE_URL=http://api:8000

# Allowed browser origins for API CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:13000,http://127.0.0.1:13000

# ------------------------------
# Optional TCGA full475 data mount
# ------------------------------
# Host path to your primary full475 dataset root.
# Use an absolute path when possible.
TCGA_FULL475_HOST_PATH=./data/tcga-full475

# Optional split-dataset host mounts (for portability across machines)
# Useful when embeddings, transcriptomics, or clinical files live outside TCGA_FULL475_HOST_PATH.
LUAD_EMBEDDINGS_HOST_PATH=./data/tcga-full475/embeddings
TRANSCRIPTOMICS_HOST_PATH=./data/tcga-full475/transcriptomics
CLINICAL_HOST_PATH=./data/tcga-full475/clinical

# Path inside containers where the primary dataset is mounted.
TCGA_FULL475_ROOT=/data/tcga-full475

# Optional explicit overrides (inside container paths).
# Keep these aligned with your mounted dataset layout.
PATHOLOGY_ARTIFACT_DIR=/data/tcga-full475/pathology_artifacts/full475
PATHOLOGY_HEATMAP_DIR=/data/tcga-full475/heatmaps/full475
PATHOLOGY_WSI_DIR=/data/tcga-full475/slides/full475
PATHOLOGY_STRICT_MISSING_DATA=false
PATHOLOGY_SEGLUNG_DIR=/data/tcga-full475/pathology_artifacts/seglung
PATHOLOGY_TILE_ENCODER_MODEL=google/path-foundation
ENSO_API_BASE_URL=http://127.0.0.1:8003
# Point to /data/luad-embeddings when LUAD_EMBEDDINGS_HOST_PATH is used.
ENSO_EMBEDDINGS_DIR=/data/tcga-full475/embeddings/level0
# If transcriptomics/clinical are mounted via split paths above, point these to /data/transcriptomics and /data/clinical.
TRANSCRIPTOMICS_ARTIFACT_DIR=/data/tcga-full475/transcriptomics/artifacts
TRANSCRIPTOMICS_COUNTS_DIR=/data/tcga-full475/transcriptomics/counts
CLINICAL_ARTIFACT_DIR=/data/tcga-full475/clinical/artifacts
CLINICAL_XML_DIR=/data/tcga-full475/clinical/xml
CLINICAL_REPORTS_DIR=/data/tcga-full475/clinical/reports

# Optional defaults consumed by scripts/audit_luad_embedding_coverage.py
LUAD_AUDIT_MANIFEST=/data/tcga-full475/tcga_luad_exact_matched_manifest_slides.tsv
LUAD_AUDIT_EMBEDDINGS_DIR=/data/tcga-full475/embeddings/level0
LUAD_AUDIT_ARTIFACTS_DIR=/data/tcga-full475/pathology_artifacts/full475
