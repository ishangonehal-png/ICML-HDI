# but skip per-output build artifacts and intermediate scratch
scripts/__pycache__/
__pycache__/
*.pyc
*.db
*.sqlite3
*.tsbuildinfo
hansons-context/tcga_downloads/
.pytest_cache/
data/manifests/*
!data/manifests/README.md
!data/manifests/.gitkeep

# External reference PDF (not part of this work)
2025.bionlp-1.pdf

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
