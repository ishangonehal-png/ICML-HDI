# Browser-facing API base URL (client-side fetches)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional server-side API base URL for Next.js SSR/runtime in containers.
INTERNAL_API_BASE_URL=http://localhost:8000

# Disable typed mock fallback when backend errors (recommended for deployment/runtime validation).
NEXT_PUBLIC_DISABLE_MOCK_FALLBACK=true
