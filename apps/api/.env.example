APP_NAME="YC AIxBio Research API"
APP_ENV="development"
API_V1_PREFIX="/v1"

# PostgreSQL is the canonical source of truth for structured backend state.
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/aixbio"

# Redis is reserved for async orchestration/queue state.
REDIS_URL="redis://localhost:6379/0"
ANALYSIS_QUEUE_KEY="aixbio:analysis:jobs"
ANALYSIS_QUEUE_PROCESSING_KEY="aixbio:analysis:jobs:processing"
ANALYSIS_QUEUE_DEDUPE_TTL_SECONDS="86400"
ANALYSIS_WORKER_POLL_TIMEOUT_SECONDS="5"
ANALYSIS_WORKER_REQUEUE_INFLIGHT_ON_START="true"

# Comma-separated origins for browser clients (CORS).
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Local-only convenience: auto-create tables on app startup.
AUTO_CREATE_TABLES="true"

# Optional data root override used by pathology/transcriptomics/clinical services.
# Example: /data/tcga-full475 (container) or /absolute/path/on/host (local)
# TCGA_FULL475_ROOT=""

# Optional explicit overrides (take precedence over TCGA_FULL475_ROOT when set):
# ENSO_EMBEDDINGS_DIR=""
# PATHOLOGY_ARTIFACT_DIR=""
# PATHOLOGY_SEGLUNG_DIR=""
# PATHOLOGY_TILE_ENCODER_MODEL="google/path-foundation"
# TRANSCRIPTOMICS_ARTIFACT_DIR=""
# TRANSCRIPTOMICS_COUNTS_DIR=""
# CLINICAL_ARTIFACT_DIR=""
# CLINICAL_XML_DIR=""
# CLINICAL_REPORTS_DIR=""
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4o-mini"
